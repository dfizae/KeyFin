// MR validation job: use a regular Pipeline job with the Jenkins GitLab plugin.
// Pipeline script from SCM: this repository, branch */develop, Script Path Jenkinsfile.mr.
// Commit this file to that branch before enabling the job. SCM credentials are reused below.
// Select the GitLab connection (with an API token) in the job configuration.
// Configure the trigger in the UI so its webhook secret stays out of source control:
//   - Created Merge Request Events: enabled; Rebuild open Merge Requests: On push to source branch.
//   - Push Events, Accepted/Closed Merge Request Events, and Pipeline Events: disabled.
//   - Branch filter: RegexBasedFilter; source: .*; target: ^develop$.
//   - Pending build name for pipeline: backend-mr-ci; CI skip: disabled.
// The GitLab webhook for this job must send both Merge request events and Push events.
// In GitLab, enable Pipelines must succeed and leave skipped pipelines unsuccessful.

def reportMrStatus = false

pipeline {
    agent { label 'backend-ci' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Validate MR Event') {
            steps {
                script {
                    if (!(env.gitlabMergeRequestIid ==~ /[1-9][0-9]*/) ||
                        !env.gitlabSourceBranch ||
                        !(env.gitlabMergeRequestLastCommit ==~ /[0-9a-fA-F]{40}/)) {
                        error('This job requires a GitLab MR event. Trigger it by opening or updating an MR.')
                    }

                    if (env.gitlabTargetBranch != 'develop') {
                        error('This job only validates merge requests targeting develop.')
                    }

                    if (env.gitlabMergeRequestState &&
                        !(env.gitlabMergeRequestState in ['opened', 'reopened'])) {
                        error('This job only validates open merge requests.')
                    }

                    reportMrStatus = true
                    // The GitLab plugin reports against the source commit in the webhook cause.
                    updateGitlabCommitStatus name: 'backend-mr-ci', state: 'running'
                }
            }
        }

        stage('Checkout MR Commit') {
            steps {
                deleteDir()

                script {
                    if (scm.userRemoteConfigs.size() != 1) {
                        error('Configure exactly one Git remote for this Pipeline job.')
                    }

                    def remote = scm.userRemoteConfigs[0]
                    def mrRef = "refs/merge-requests/${env.gitlabMergeRequestIid}/head"

                    // Fetch the MR ref from the configured repository and pin the webhook SHA.
                    // A newer push must never make an older build test a different commit.
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.gitlabMergeRequestLastCommit]],
                        extensions: [[$class: 'CloneOption',
                                      shallow: false, noTags: true,
                                      honorRefspec: true, timeout: 10]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: remote.url,
                            credentialsId: remote.credentialsId,
                            refspec: "+${mrRef}:refs/remotes/origin/mr-${env.gitlabMergeRequestIid}"
                        ]]
                    ])

                    def checkedOutCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    if (!checkedOutCommit.equalsIgnoreCase(env.gitlabMergeRequestLastCommit)) {
                        error('The checked-out commit does not match the GitLab MR event.')
                    }
                }

                sh 'git log -1 --format="%H %s"'
            }
        }

        stage('Environment Check') {
            steps {
                // Integration tests use Testcontainers, even though this job does not deploy.
                sh '''
                    set -eu
                    echo "Node: $NODE_NAME"
                    java -version
                    javac -version
                    git --version
                    test -S /var/run/docker.sock
                    test -r /var/run/docker.sock
                    test -w /var/run/docker.sock
                '''
            }
        }

        stage('Backend Test') {
            steps {
                dir('backend/key-fin') {
                    sh 'bash ./gradlew --no-daemon --max-workers=1 --console=plain --stacktrace clean test'
                }
            }
            post {
                always {
                    junit testResults: 'backend/key-fin/build/test-results/test/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Package JAR') {
            steps {
                dir('backend/key-fin') {
                    sh 'bash ./gradlew --no-daemon --max-workers=1 --console=plain --stacktrace bootJar'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/key-fin/build/libs/*.jar',
                                     fingerprint: true
                }
            }
        }
    }

    post {
        always {
            script {
                if (reportMrStatus) {
                    // One status covers all stages, so passing tests alone cannot permit a merge.
                    // JUnit UNSTABLE is a failure for the merge gate; aborts remain non-successful.
                    def states = [SUCCESS: 'success', FAILURE: 'failed',
                                  UNSTABLE: 'failed', ABORTED: 'canceled']
                    updateGitlabCommitStatus name: 'backend-mr-ci',
                                             state: states[currentBuild.currentResult] ?: 'failed'
                }
            }
        }
    }
}
